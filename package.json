{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "fold",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "bun run build:packages",
		"build:packages": "bun run scripts/build/packages.ts",
		"build:providers": "bun run scripts/build/packages.ts --providers --quiet",
		"build:binaries": "bun run scripts/build/binaries.ts",
		"release:tag-info": "bun run scripts/release/tag-info.ts",
		"release:prepare": "bun run scripts/release/prepare.ts",
		"release:validate": "bun run scripts/release/validate-manifest.ts",
		"release:publish": "bun run scripts/release/publish.ts",
		"typecheck": "bun run build:providers && bun run --parallel --if-present --filter './packages/*' --filter './examples/*' typecheck",
		"test": "bun run --parallel --if-present --filter './packages/*' --filter './examples/*' test",
		"test:watch": "bun run --parallel --if-present --filter './packages/*' --filter './examples/*' test:watch",
		"lint": "oxlint --type-aware && bun tools/typed/src/cli.ts check --config typed-lint.config.ts",
		"lint:fix": "oxlint --type-aware --fix && bun tools/typed/src/cli.ts check --config typed-lint.config.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"prepare": "effect-tsgo patch --typescript --oxlint --force"
	},
	"workspaces": {
		"packages": [
			"packages/*",
			"examples/*"
		],
		"catalog": {
			"@kitlangton/terminal-control": "0.3.1",
			"alchemy": "2.0.0-beta.80",
			"@cloudflare/computer": "https://github.com/K-Mistele/computer/releases/download/fold-91611593a1d7/cloudflare-computer-0.3.1.tgz",
			"@platformatic/vfs": "0.4.0",
			"@cloudflare/workers-types": "5.20260929.1",
			"@opentui/core": "0.4.3",
			"@opentui/keymap": "0.4.3",
			"@opentui/solid": "0.4.3",
			"solid-js": "1.9.12",
			"effect": "4.0.0",
			"@effect/platform-node": "4.0.0",
			"@effect/platform-bun": "4.0.0",
			"@effect/vitest": "4.0.0",
			"@silvia-odwyer/photon-node": "0.3.4",
			"turndown": "7.2.4",
			"@types/turndown": "5.0.6",
			"yaml": "2.9.0",
			"vitest": "4.1.9",
			"@vitest/coverage-v8": "4.1.9",
			"typescript": "7.0.2",
			"@types/bun": "1.3.14",
			"@types/node": "26.1.0"
		}
	},
	"devDependencies": {
		"@effect/tsgo": "0.48.0",
		"@oxlint/plugins": "1.86.0",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"effect": "catalog:",
		"fast-glob": "3.3.3",
		"oxfmt": "0.62.0",
		"oxlint": "1.86.0",
		"oxlint-tsgolint": "7.0.2003",
		"typescript": "catalog:",
		"typescript-compiler": "npm:typescript@6.0.2",
		"vitest": "catalog:"
	}
}
